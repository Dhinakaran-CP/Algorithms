#include <bits/stdc++.h>
using namespace std;

int search(vector<int>& nums , int target){
    int low = 0;
    int high = nums.size()-1;

    while(low <= high){
        int mid = low +(high-low)/2;
        if(nums[mid] == target){
            return mid;
        }
        else if(nums[mid] < target){
            low = mid + 1;
        }
        else{
            high = mid - 1;
        }
    }
    return -1;
}

int lower_bound(vector<int>& nums , int target){
    int low = 0;
    int high = nums.size();

    while(low < high){
        int mid = low +(high-low)/2;
        if(nums[mid] >= target){
            high = mid;
        }
        else{
            low = mid + 1;
        }
    }
    return low;
}

